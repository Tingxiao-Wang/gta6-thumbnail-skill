  "screenshot_layout_preflight": [
    "截图再设计首先进行真实图像观察：主体位置、地平线、负空间、可裁切边缘，然后根据实际内容灵活调整归一化预设框。",
    "用户截图全画幅铺底，不在灰白页面里绘制小截图。画幅预设仅决定最终尺寸和重排，不能拉伸失真。",
    "电影海报感只影响画面质感和视觉语言，不允许自动建立相框/画中画/纸质海报样机。",
    "长标题在负空间按语义断行，文字与背景形成合理区域对比，不一定固定顶端。",
    "原图裁切损伤重要主体时优先延展可延展环境；不可用则缩小裁切范围并如实说明。"
  ],
  "cross_platform_screenshot_composition": {
    "xiaohongshu": "竖幅中上字区+中部主体；横版截图需保主体竖向重构，内容满版。",
    "bilibili": "4:3横幅独立构图，必要时16:9另做；强调截图真实人物/城市及文字负空间，非套框。",
    "youtube": "16:9高辨识度焦点+一块主标题；可选9:16 Shorts单独重构，语言由用户决定。"
  },
  "v16_layout_contract": "references/platform_layout_rules.json::platforms[*].layouts",
  "v16_dispatch_order": [
    "输入画幅→读取平台输出预设",
    "截图识别保护主体与可读负空间",
    "根据内容类型选平台 layout_selection → layout_id",
    "优先图层标题不盖主体，按需要镜像/用备选布局",
    "双比例另构图，不进行一键压缩拉伸"
  ],
  "v16_bilibili_center_crop_preview": {
    "enabled_when": "need_4_3_safe_preview_only",
    "crop_normalized": {
      "x": 0.125,
      "y": 0,
      "w": 0.75,
      "h": 1
    },
    "note": "中心四分之三宽仅代表同高度16:9→4:3的几何预览；正式双版分别重排元素"
  }
}
