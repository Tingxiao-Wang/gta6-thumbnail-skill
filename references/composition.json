{
  "version": "1.6.0",
  "measurement": "relative_canvas_0_to_1",
  "status": "internal_design_heuristic_not_official_platform_rule",
  "coordinate_definition": "x/y 起点为画布左上角，w/h 为归一化宽高，范围 0–1；是推荐区域而非强制像素裁切。绘图模型可能无法精确执行。",
  "ratios": {
    "16:9": "wide",
    "4:3": "standard",
    "3:4": "portrait",
    "9:16": "tall",
    "1:1": "standard"
  },
  "safe_zones": {
    "wide": {
      "outer_margin_pct": 6,
      "critical_text": "6%–90% canvas width; avoid lower-right 16%×14% if UI may overlay",
      "origin": "design recommendation"
    },
    "standard": {
      "outer_margin_pct": 7,
      "critical_text": "7%–90% canvas width; keep main content away from lower-right corner",
      "origin": "design recommendation"
    },
    "portrait": {
      "outer_margin_pct": 8,
      "critical_text": "8%–92% canvas width; lower 18% avoid fine crucial text",
      "origin": "design recommendation"
    },
    "tall": {
      "outer_margin_pct": 8,
      "critical_text": "8%–92% canvas width; upper/lower 15% avoid crucial fine text",
      "origin": "design recommendation"
    }
  },
  "rules": [
    "先确定用户尺寸/比例，再挑选 aspect profile；优先清晰主体和标题安全区。",
    "一个主视觉焦点；仅主播和对比类型允许清晰的双主体。",
    "比例变化时重新生成/重排主体和文本，禁止拉伸失真。",
    "标题区可以根据真实上传图里的重点位置镜像/微调，但不能遮挡需指向的证据。",
    "关键主体尽量完整（脸、头盔、车轮、动作落点），避免莫名裁断。",
    "同一画面最多一个主标题块，角标/箭头不属于必选装饰。"
  ],
