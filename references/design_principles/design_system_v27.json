  "global_principles": [
    {
      "id": "01",
      "name": "游戏识别",
      "rule": "保留可辨识的人物、场景、载具或环境，不强制官方KV。"
    },
    {
      "id": "02",
      "name": "单一焦点",
      "rule": "只设一个最高视觉权重的主体。"
    },
    {
      "id": "03",
      "name": "内容驱动",
      "rule": "先理解看点，再选择设计。"
    },
    {
      "id": "04",
      "name": "视觉重构",
      "rule": "除原生及极简风格，不得只在截图叠字。"
    },
    {
      "id": "05",
      "name": "图层层次",
      "rule": "建立背景、主体、信息与辅助元素主次。"
    },
    {
      "id": "06",
      "name": "色彩差异",
      "rule": "按内容选配色，不默认粉紫。"
    },
    {
      "id": "07",
      "name": "文案精简",
      "rule": "文字承担点击钩子，不复述标题。"
    },
    {
      "id": "08",
      "name": "真实表达",
      "rule": "不虚构事实，不把AI画面冒充实机。"
    }
  ],
