  "semantics": {
    "coordinate_system": "x,y,w,h 为相对于整张成品画布的 0–1 坐标，左上角为原点，画面铺满整个画布。",
    "headline_block_height_percent": "主标题图层（包括所有行与行间距）占成品画布高度的比例，不等于单个字的字号。",
    "font_size_h_ratio": "单行标题建议字号相对画布高度，字号比例仅在宿主支持精确排版时才能严格执行。",
    "title_position": "优先根据原图负空间选预设布局；不能让标题遮挡必须保留的真人脸、车头、关键游戏事件。",
    "masking_and_crop": "同平台不同比例需要重构布局，不能只靠整体缩放或强制裁切。",
    "hard_vs_soft": "hard_rule 指设计系统要求；target_range 是可测试的产品排版目标，不是官方审核标准，更不能保证纯文生图模型像素级执行。",
    "ratio_recomposition": "If requested ratio differs from platform default, use ratio_layout_overrides[ratio][layout_id] when available; if none, independently recompose using composition.json and visually verify. Dual exports never stretch."
  },
  "priority_order": [
    "explicit_user_title_text_and_no_text_request",
    "explicit_user_platform_and_aspect_ratio",
    "preserve_uploaded_subject_and_true_scene",
    "global_negative_rules_and_content_safety",
    "platform_output_and_layout_contract",
    "content_style_recipe_and_title_variants",
    "automatic_aesthetic_defaults"
  ],
  "global_hard_rules": {
    "source_image_mode": "uploaded_screenshot => screenshot_based_cover (when image accessible)",
    "full_bleed": true,
    "outer_paper_or_canvas": false,
    "unrequested_framed_inset": false,
    "source_subject_lock": true,
    "user_title_exact": true,
    "user_title_auto_rewrite": false,
    "body_text_not_invent_game_facts": true,
    "platform_ui_watermark_play_counts_duration": false,
    "cinematic_means": "电影化的视频封面画面语言，而不是印刷海报样机/画中画。",
    "screenshot_processing_minimum": [
      "观察人物/车辆/关键地标/负空间",
      "按目标画幅重新裁切或适当延展",
      "对文字区域做局部明暗托底",
      "主体与背景做有节制的层次增强",
      "进行缩略图可读性与标题字形检查"
    ],
    "no_arbitrary_new_subjects": true,
    "only_add_labels_if_verified_or_generic": "可选纯分类词；不能虚构实机、泄露、官方结论或排行榜。",
    "skip_asking_when": "有截图+平台+指定标题/风格→直接设计；缺少影响内容意义的关键方向时最多一次高价值追问。"
  },
  "global_anti_patterns": [
    "截图缩小居中+灰色/白色大底",
    "外边框、影楼相框、印刷海报挂墙样机",
    "仅在截图顶端贴一行字",
    "默认紫粉霓虹豪车替代用户实图",
    "无凭据增加游戏事实与官方标签",
    "强行把用户标题翻译成英文或改写",
    "为了字大遮挡人脸/车头/动作证据",
    "直接拉伸改变比例",
    "伪造平台播放量/视频时长/点赞UI"
  ],
  "workflow": [
    "读取用户材料、图片、平台和原文标题，优先保真；判断是否需要追问",
    "确定发布平台与输出预设，枚举该平台 layouts；按真实画面负空间和内容类别选定唯一布局ID",
    "先锁定主体框/禁遮挡区，再把标题、标签、副标题分配到相应规范框；无依据时不增加标签和副标题",
    "按本平台 title_design、headline_size 与 screenshot_processing 参数规划层级、颜色和局部光影",
    "优先原图图生图/图像编辑；若支持独立可编辑文字，则先无字场景再叠字，确保逐字正确",
    "生成后检查比例、全版、原图主体、文字、视觉焦点、截图二次处理是否确实发生；不通过时有限修正",
    "保留当前会话 brief 的 ratio、layout_id、title_exact、subject_locks 以供二次修改"
  ],
  "quality_gates": {
    "H1_full_bleed": "图片内容延伸到全部画布边缘，无灰纸边/悬空截图",
    "H2_title_exact": "用户提供的标题逐字准确（允许按语义换行、分色，不得改写添加标点）",
    "H3_source_lock": "没有改掉用户指定主体、城市关系、车型或事件",
    "H4_layout": "采用所选布局的主体与标题区域，标题不挡住关键证据",
    "H5_ratio": "实际生成/导出的宽高比符合目标，或明确披露工具限制",
    "H6_packaging": "不止把截图加字；有可见的局部色彩/对比/层次整合",
    "H7_legibility": "缩小至320px宽（竖版可用240px）时，主标题与主体仍可理解",
    "H8_not_fake": "未伪造事实或平台UI"
  },
  "capability_limit": "设计合同可被文字指令约束，但无法单靠 SKILL.md 保证豆包/WorkBuddy图像模型遵守精确坐标与字号；有叠字/裁切工具时应实际执行并检查像素，没有时检查成品并诚实说明。",
